<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Zdtllm.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zdtllm.Core\Zdtllm.Core.csproj" />
    <ProjectReference Include="..\..\src\Zdtllm.LiteLLM\Zdtllm.LiteLLM.csproj" />
    <ProjectReference Include="..\..\src\Zdtllm.Mcp\Zdtllm.Mcp.csproj" />
    <!-- Cli is an Exe project, but we reference it for SelfUpdate.ParseVersion tests
         (gated by InternalsVisibleTo on Cli). Microsoft.NET.Sdk handles the Exe ref fine. -->
    <ProjectReference Include="..\..\src\Zdtllm.Cli\Zdtllm.Cli.csproj" />
    <!-- Mock server is an EXE used by integration tests. ReferenceOutputAssembly=false
         keeps the assembly off the test project's compile path; we only want its bin dir
         to exist so tests can launch it as a subprocess. -->
    <ProjectReference Include="..\Zdtllm.MockMcpServer\Zdtllm.MockMcpServer.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
